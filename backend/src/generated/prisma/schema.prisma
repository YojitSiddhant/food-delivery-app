generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Food {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  price       Float
  category    String
  image       String
}

model Order {
  id          Int    @id @default(autoincrement())
  userId      Int
  totalAmount Float
  status      String @default("Pending")
}
